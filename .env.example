# Copy to `.env` in the repo root and fill in. `.env` is git-ignored.
# Every Spring service imports ../.env automatically (spring.config.import).

# --- Shared secrets ---------------------------------------------------------
# Same value in user + redirect + analytics. Must be Base64, >= 32 bytes.
#   openssl rand -base64 32
JWT_SECRET=

# Redirect service: salt for Hashids short codes. Changing it invalidates every
# existing short code, so keep it stable per environment.
#   openssl rand -hex 16
HASHIDS_SALT=

# Signs API keys (user issues them, redirect verifies them via the X-API-Key header) so a key's
# validity can be checked without a database lookup. Same value in user + redirect.
#   openssl rand -base64 32
API_KEY_SIGNING_SECRET=

# --- OAuth (user service) ---------------------------------------------------
# Google: console.cloud.google.com -> APIs & Services -> Credentials ->
#   Create credentials -> OAuth client ID -> Web application.
#   Authorized redirect URI:  http://localhost:8080/login/oauth2/code/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitHub: github.com/settings/developers -> OAuth Apps -> New OAuth App.
#   Authorization callback URL:  http://localhost:8080/login/oauth2/code/github
#   (GitHub allows one callback URL per app: create a second app for production.)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# --- URLs --------------------------------------------------------------------
# Where the Next.js frontend is served (post-login redirect + CORS allow-list).
FRONTEND_URL=http://localhost:3001

# --- Optional ----------------------------------------------------------------
# Google Safe Browsing API key. Empty = link safety checks disabled.
SAFE_BROWSING_API_KEY=

# GeoLite2 City database (free download from MaxMind; needs no API key to read).
# Empty/missing file = click geolocation disabled ("Unknown").
GEOLITE_PATH=./data/GeoLite2-City.mmdb
