# Copy to `.env.local` (git-ignored). All values below are the local-development defaults.

# Where the browser is sent to start OAuth login (the user service).
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080

# Public base URL of short links (what gets copied to the clipboard). Production: your short domain.
NEXT_PUBLIC_SHORT_LINK_BASE_URL=http://localhost:8081

# Backend service URLs used by the rewrites in next.config.ts (read at build time).
USER_SERVICE_URL=http://localhost:8080
REDIRECT_SERVICE_URL=http://localhost:8081
ANALYTICS_SERVICE_URL=http://localhost:8082

# --- Vercel (Project -> Settings -> Environment Variables, scope "Production") -------------------------------------
# None of these are secrets: NEXT_PUBLIC_* values are inlined into the browser bundle and the *_SERVICE_URL values
# are baked into the rewrites, all at BUILD time. Changing any of them only takes effect after a redeploy.
# No trailing slashes. Full guide: docs/DEPLOY.md.
#
# NEXT_PUBLIC_API_BASE_URL must be the Vercel origin itself, NOT the user service: login then starts and returns
# through the /oauth2 and /login/oauth2 rewrites, so the session cookie is set on the Vercel domain, where
# /api/v1/users/me can read it. (Locally this works with :8080 only because cookies ignore ports.)
#   NEXT_PUBLIC_API_BASE_URL=https://<your-app>.vercel.app
#   NEXT_PUBLIC_SHORT_LINK_BASE_URL=https://redirect-xxxxxxxxxx-xx.a.run.app   (or your short domain mapped to it)
#   USER_SERVICE_URL=https://user-xxxxxxxxxx-xx.a.run.app
#   REDIRECT_SERVICE_URL=https://redirect-xxxxxxxxxx-xx.a.run.app
#   ANALYTICS_SERVICE_URL=https://analytics-xxxxxxxxxx-xx.a.run.app
