# pnpm on Windows — see https://pnpm.io/npmrc
# Hoisted layout (fewer symlinks under node_modules than default isolated).
node-linker=hoisted
# Keep the content-addressable store on the same drive as the project (avoids broken
# global store at e.g. D:\.pnpm-store and many symlink permission issues).
store-dir=.pnpm-store
# Copy packages from store instead of symlinking files (helps when symlinks are blocked).
package-import-method=copy
