# Copy to .env and fill in. Do not commit .env.

# Shared across user (8080), redirect (8081), analytics (8082)
JWT_SECRET=
API_KEY_SIGNING_SECRET=

# user service — OAuth redirect target (must match Next dev URL)
# APP_FRONTEND_URL=http://localhost:3000

# Next.js (viral-analytics-hub/.env.local)
# NEXT_PUBLIC_REDIRECT_BASE_URL=http://localhost:8081

# redirect only
HASHIDS_SALT=change-me-local-dev-only

# user OAuth (optional for local login)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# redirect URL expander (optional)
SAFE_BROWSING_API_KEY=

# analytics GeoIP (optional)
# GEOLITE_PATH=
